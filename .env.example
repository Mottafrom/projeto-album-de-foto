# Frontend (Vite) — em Docker deixe vazio (same-origin via nginx)
VITE_API_URL=http://localhost:3001

# Backend
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Produção / app normal: Supabase (ou outro Postgres do .env)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Quando api sobe no Docker com --profile local, use o host "postgres" da rede:
# LOCAL_DATABASE_URL=postgresql://memories:memories@postgres:5432/memories

BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=memories

ADMIN_EMAIL=admin@memories.local
ADMIN_PASSWORD=change-me-strong-password

MAX_UPLOAD_BYTES=5242880
